<Window x:Class="GifPin.UI.SpriteImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource s.sprite.title}" Width="820" Height="600" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13" Icon="/Assets/GifPin.ico" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>

    <!-- 미리보기 -->
    <DockPanel Margin="20,18,20,16">
      <TextBlock DockPanel.Dock="Top" Text="{DynamicResource s.sprite.preview}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
      <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
      <Border CornerRadius="10" Background="{DynamicResource CheckerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          <TextBlock x:Name="PreviewHint" Text="{DynamicResource s.sprite.dropHint}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
        </Grid>
      </Border>
    </DockPanel>

    <!-- 설정 -->
    <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
      <DockPanel Margin="18,18,18,16">
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="{DynamicResource s.sprite.name}" Style="{StaticResource SectionLabel}"/>
          <TextBox x:Name="NameBox" Margin="0,6,0,0"/>
          <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Height="40" Content="{DynamicResource s.common.cancel}" BorderBrush="{DynamicResource BorderStrongBrush}" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Grid.Column="2" Height="40" Style="{StaticResource BtnPrimary}" Content="{DynamicResource s.sprite.save}" Click="Save_Click" IsEnabled="False"/>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="Options">
          <Border Style="{StaticResource SegmentBox}">
            <UniformGrid Columns="2">
              <RadioButton x:Name="ModeSheet" Style="{StaticResource Segment}" GroupName="mode" Content="{DynamicResource s.sprite.modeSheet}" IsChecked="True" Checked="Mode_Checked"/>
              <RadioButton x:Name="ModeFolder" Style="{StaticResource Segment}" GroupName="mode" Content="{DynamicResource s.sprite.modeFolder}" Checked="Mode_Checked"/>
            </UniformGrid>
          </Border>

          <Button x:Name="PickButton" Height="36" Margin="0,12,0,0" Style="{StaticResource BtnSecondary}" Click="Pick_Click"/>
          <TextBlock x:Name="SourceText" Style="{StaticResource Hint}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

          <StackPanel x:Name="SheetOptions" Margin="0,14,0,0">
            <TextBlock Text="{DynamicResource s.sprite.grid}" Style="{StaticResource SectionLabel}"/>
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource s.sprite.columns}" Style="{StaticResource Hint}"/>
                <TextBox x:Name="ColsBox" Margin="0,4,0,0" FontFamily="{DynamicResource MonoFont}" TextChanged="Option_Changed"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource s.sprite.rows}" Style="{StaticResource Hint}"/>
                <TextBox x:Name="RowsBox" Margin="0,4,0,0" FontFamily="{DynamicResource MonoFont}" TextChanged="Option_Changed"/>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="{DynamicResource s.sprite.count}" Style="{StaticResource Hint}"/>
                <TextBox x:Name="CountBox" Margin="0,4,0,0" FontFamily="{DynamicResource MonoFont}" TextChanged="Option_Changed"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource s.sprite.gridHint}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          </StackPanel>

          <DockPanel Margin="0,16,0,0">
            <TextBlock x:Name="FpsText" DockPanel.Dock="Right" FontFamily="{DynamicResource MonoFont}"/>
            <TextBlock Text="{DynamicResource s.sprite.fps}" Style="{StaticResource SectionLabel}"/>
          </DockPanel>
          <Slider x:Name="FpsSlider" Minimum="1" Maximum="60" Value="12" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,0" ValueChanged="Fps_ValueChanged"/>

          <ToggleButton x:Name="PixelToggle" Style="{StaticResource SwitchBox}" Margin="0,14,0,0" IsChecked="True"
                        Content="{DynamicResource s.panel.pixelArt}" ToolTip="{DynamicResource s.panel.pixelArtTip}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
