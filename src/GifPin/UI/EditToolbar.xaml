<Window x:Class="GifPin.UI.EditToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GifPin 편집 모드" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </Window.Resources>

  <StackPanel Margin="16">
    <Border x:Name="Bar" Background="#12151B" BorderBrush="#2E3441" BorderThickness="1" CornerRadius="14" Padding="14,8,8,8"
            MouseLeftButtonDown="Bar_MouseDown">
      <Border.Effect>
        <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.45" Color="Black"/>
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Border CornerRadius="13" Background="#294C8DFF" Padding="10,4" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="편집 중" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/>
          </StackPanel>
        </Border>

        <Button x:Name="PickButton" Margin="12,0,0,0" Height="40" Padding="4,0,10,0" Background="#181C24" Click="PickButton_Click"
                ToolTip="편집할 GIF 고르기 (겹쳐서 클릭하기 어려울 때)">
          <StackPanel Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource CheckerBrush}">
              <Image x:Name="SelThumb" Stretch="Uniform" Margin="2"/>
            </Border>
            <TextBlock x:Name="SelName" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu/>
          </Button.ContextMenu>
        </Button>

        <Border Width="1" Height="28" Background="{StaticResource BorderBrush}" Margin="12,0"/>

        <TextBlock Text="크기" Foreground="{StaticResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button Width="32" Height="32" Padding="0" Click="Smaller_Click" ToolTip="작게 (-10%)">
          <TextBlock Text="&#xE738;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
        </Button>
        <TextBlock x:Name="ScaleText" Width="58" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
        <Button Width="32" Height="32" Padding="0" Click="Bigger_Click" ToolTip="크게 (+10%)">
          <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
        </Button>
        <Button Height="32" Margin="6,0,0,0" Content="원래 크기" FontSize="12" Click="Reset_Click"/>

        <Border Width="1" Height="28" Background="{StaticResource BorderBrush}" Margin="12,0"/>

        <Button Height="40" Padding="16,0" Content="취소" BorderBrush="{StaticResource BorderStrongBrush}" Click="Cancel_Click" ToolTip="편집 전 상태로 되돌리기 (Esc)"/>
        <Button Height="40" Padding="18,0" Margin="8,0,0,0" Style="{StaticResource BtnPrimary}" Content="완료" Click="Done_Click" ToolTip="저장하고 끝내기 (Enter)"/>
      </StackPanel>
    </Border>

    <Border HorizontalAlignment="Center" Margin="0,10,0,0" Background="#C70C0E12" CornerRadius="15" Padding="14,6" IsHitTestVisible="False">
      <TextBlock FontSize="12" Foreground="{StaticResource LabelBrush}">
        <Run Text="드래그" FontWeight="Bold" Foreground="White"/><Run Text=" 이동   "/>
        <Run Text="모서리" FontWeight="Bold" Foreground="White"/><Run Text=" 크기   "/>
        <Run Text="휠" FontWeight="Bold" Foreground="White"/><Run Text=" ±10%   "/>
        <Run Text="방향키" FontWeight="Bold" Foreground="White"/><Run Text=" 1px (Shift 10px)   "/>
        <Run Text="Alt" FontWeight="Bold" Foreground="White"/><Run Text=" 자석 끄기   "/>
        <Run Text="Delete" FontWeight="Bold" Foreground="White"/><Run Text=" 내리기   "/>
        <Run Text="Enter" FontWeight="Bold" Foreground="White"/><Run Text=" 완료   "/>
        <Run Text="Esc" FontWeight="Bold" Foreground="White"/><Run Text=" 취소"/>
      </TextBlock>
    </Border>
  </StackPanel>
</Window>
