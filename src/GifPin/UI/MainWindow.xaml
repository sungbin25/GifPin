              <TextBlock x:Name="AutoLightStatus" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Height="1" Background="{StaticResource LineBrush}"/>
            <ToggleButton x:Name="PauseFxFullscreenToggle" Style="{StaticResource Switch}" Margin="18,14" Click="FxPause_Click">
              <StackPanel>
                <TextBlock Text="{DynamicResource s.set.fxPauseFullscreen}" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{DynamicResource s.set.fxPauseFullscreenDesc}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </ToggleButton>
            <Border Height="1" Background="{StaticResource LineBrush}"/>
            <ToggleButton x:Name="PauseFxBatteryToggle" Style="{StaticResource Switch}" Margin="18,14" Click="FxPause_Click">
              <StackPanel>
                <TextBlock Text="{DynamicResource s.set.fxPauseBattery}" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{DynamicResource s.set.fxPauseBatteryDesc}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource s.set.mouse}" Style="{StaticResource SettingsHeader}"/>
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="{DynamicResource s.set.mouseHint}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="18,14,18,0"/>
            <DockPanel Margin="18,12,18,14">
              <StackPanel DockPanel.Dock="Right" Width="240" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HoldText" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"/>
                <Slider x:Name="HoldSlider" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="HoldSlider_ValueChanged"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource s.set.holdTitle}" FontSize="14"/>
                <TextBlock Text="{DynamicResource s.set.holdDesc}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Height="1" Background="{StaticResource LineBrush}"/>
            <DockPanel Margin="18,14">
              <StackPanel DockPanel.Dock="Right" Width="240" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ResumeText" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"/>
                <Slider x:Name="ResumeSlider" Minimum="0" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True" Margin="0,4,0,0" ValueChanged="ResumeSlider_ValueChanged"/>
              </StackPanel>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource s.set.resumeTitle}" FontSize="14"/>
                <TextBlock Text="{DynamicResource s.set.resumeDesc}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource s.set.hotkeys}" Style="{StaticResource SettingsHeader}"/>
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="{DynamicResource s.hotkey.hint}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="18,14,18,2"/>
            <StackPanel x:Name="HotkeyRows"/>
            <DockPanel Margin="18,6,18,14">
              <Button DockPanel.Dock="Right" Height="30" Content="{DynamicResource s.hotkey.reset}" Click="ResetHotkeys_Click"/>
              <TextBlock x:Name="HotkeyMessage" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource s.set.library}" Style="{StaticResource SettingsHeader}"/>
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <DockPanel Margin="18,14">
              <Button DockPanel.Dock="Right" Height="30" Content="{DynamicResource s.set.openFolder}" Click="OpenDataFolder_Click" Margin="12,0,0,0"/>
              <StackPanel>
                <TextBlock Text="{DynamicResource s.set.dataFolder}" FontSize="14"/>
                <TextBlock x:Name="DataFolderText" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Height="1" Background="{StaticResource LineBrush}"/>
            <ToggleButton x:Name="CopyOnAddToggle" Style="{StaticResource Switch}" Margin="18,14" Click="CopyOnAdd_Click">
              <StackPanel>
                <TextBlock Text="{DynamicResource s.set.copyOnAdd}" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{DynamicResource s.set.copyOnAddDesc}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource s.set.troubleshoot}" Style="{StaticResource SettingsHeader}"/>
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <DockPanel Margin="18,12">
              <Button DockPanel.Dock="Right" Height="32" MinWidth="120" Content="{DynamicResource s.rec.gather}" Click="RecoverGather_Click" Margin="12,0,0,0"/>
              <StackPanel>
                <TextBlock Text="{DynamicResource s.rec.gatherTitle}" FontSize="14"/>
                <TextBlock Text="{DynamicResource s.rec.gatherDesc}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Height="1" Background="{StaticResource LineBrush}"/>
            <DockPanel Margin="18,12">
              <Button DockPanel.Dock="Right" Height="32" MinWidth="120" Content="{DynamicResource s.rec.showAll}" Click="RecoverShow_Click" Margin="12,0,0,0"/>
              <StackPanel>
                <TextBlock Text="{DynamicResource s.rec.showAllTitle}" FontSize="14"/>
                <TextBlock Text="{DynamicResource s.rec.showAllDesc}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Height="1" Background="{StaticResource LineBrush}"/>
            <DockPanel Margin="18,12">
              <Button DockPanel.Dock="Right" Height="32" MinWidth="120" Content="{DynamicResource s.rec.clickThroughOff}" Click="RecoverClick_Click" Margin="12,0,0,0"/>
              <StackPanel>
                <TextBlock Text="{DynamicResource s.rec.clickThroughOffTitle}" FontSize="14"/>
                <TextBlock Text="{DynamicResource s.rec.clickThroughOffDesc}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource s.set.diagnostics}" Style="{StaticResource SettingsHeader}"/>
        <Border Style="{StaticResource SettingsCard}">
          <StackPanel Margin="18,14">
            <TextBlock x:Name="DiagText" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Height="32" Content="{DynamicResource s.diag.openLogs}" Click="OpenLogs_Click"/>
              <Button Height="32" Margin="8,0,0,0" Content="{DynamicResource s.diag.copy}" Click="CopyDiagnostics_Click"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource s.diag.hint}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" FontSize="12" Margin="0,18,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
