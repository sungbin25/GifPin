                <TextBlock Text="{DynamicResource s.set.openOnStart}" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{DynamicResource s.set.openOnStartDesc}" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

