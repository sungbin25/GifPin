<Window x:Class="GifPin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GifPin" Width="1280" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="/Assets/GifPin.ico" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 라이브러리 카드 -->
    <DataTemplate x:Key="PhotoCardTemplate">
      <Border x:Name="Card" Width="164" Margin="0,0,14,14" CornerRadius="10" Background="{StaticResource CardBrush}"
              BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
              MouseLeftButtonDown="Card_MouseDown" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="화면에 추가" Click="CardMenu_Add"/>
            <MenuItem Header="선택한 GIF와 교체" Click="CardMenu_Replace" IsEnabled="{Binding CanReplace}"/>
            <MenuItem Header="배경 지우기…" Click="CardMenu_BgRemove" FontWeight="Bold"/>
            <Separator/>
            <MenuItem Header="즐겨찾기 추가 / 해제" Click="CardMenu_Favorite"/>
            <MenuItem Header="파일 위치 열기" Click="CardMenu_OpenFolder"/>
            <Separator/>
            <MenuItem Header="라이브러리에서 제거" Click="CardMenu_Remove" Foreground="{StaticResource DangerBrush}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
          <Grid Height="148">
            <Border CornerRadius="8,8,0,0" Background="{StaticResource CheckerBrush}">
              <Image Source="{Binding Display}" Stretch="Uniform" StretchDirection="DownOnly" Margin="8"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <Border x:Name="InUseBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8" Padding="8,3" CornerRadius="10" Background="{StaticResource BadgeBgBrush}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="사용 중" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenTextBrush}"/>
              </StackPanel>
            </Border>
            <Button x:Name="StarBtn" Style="{StaticResource BtnIcon}" Width="28" Height="28" Background="#990A0E12"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Click="Card_Star" ToolTip="즐겨찾기">
              <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
            <Grid x:Name="HoverBar" VerticalAlignment="Bottom" Margin="8" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource BtnPrimary}" Height="28" Padding="0" FontSize="11.5" Content="화면에 추가" Click="Card_Add"/>
              <Button Grid.Column="2" Style="{StaticResource BtnWarn}" Height="28" Padding="0" FontSize="11.5" Content="교체"
                      Click="Card_Replace" IsEnabled="{Binding CanReplace}" ToolTip="화면 배치 바에서 선택한 GIF를 이 사진으로 바꿉니다"/>
            </Grid>
          </Grid>
          <StackPanel Margin="10,8,10,10">
            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding InUse}" Value="True">
          <Setter TargetName="InUseBadge" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Favorite}" Value="True">
          <Setter TargetName="Star" Property="Text" Value="&#xE735;"/>
          <Setter TargetName="Star" Property="Foreground" Value="#FFD166"/>
        </DataTrigger>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
          <Setter TargetName="HoverBar" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Card" Property="BorderBrush" Value="#3A4152"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 화면 배치 바 타일 -->
    <DataTemplate x:Key="ActiveTileTemplate">
      <Border x:Name="Tile" Margin="0,0,12,0" Padding="6,6,10,6" CornerRadius="10" BorderThickness="2"
              BorderBrush="#22262F" Background="{StaticResource PanelBrush}" Cursor="Hand" MouseLeftButtonDown="Tile_MouseDown">
        <StackPanel Orientation="Horizontal">
          <Border Width="64" Height="64" CornerRadius="8" Background="{StaticResource CheckerBrush}" Opacity="{Binding TileOpacity}">
            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Width="118">
            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,6"/>
            <StackPanel Orientation="Horizontal">
              <Button Width="26" Height="26" Padding="0" Click="Tile_Eye" ToolTip="{Binding EyeTip}">
                <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
              </Button>
              <Button Width="26" Height="26" Padding="0" Margin="4,0,0,0" Click="Tile_Remove" ToolTip="화면에서 내리기">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
          <Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedBgBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 탭 바 -->
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="{StaticResource ChromeBrush}">
      <DockPanel Margin="12,0,16,0" LastChildFill="False">
        <Image Source="/Assets/GifPin.ico" Width="20" Height="20" Margin="4,0,8,0" DockPanel.Dock="Left"/>
        <RadioButton x:Name="TabLibrary" Style="{StaticResource TabRadio}" GroupName="tabs" Content="라이브러리"
                     IsChecked="True" DockPanel.Dock="Left" Checked="Tab_Checked"/>
        <RadioButton x:Name="TabSettings" Style="{StaticResource TabRadio}" GroupName="tabs" Content="설정"
                     DockPanel.Dock="Left" Checked="Tab_Checked"/>
        <Button x:Name="EditModeButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Height="36" Padding="16,0"
                Margin="8,0,0,0" Click="EditMode_Click" ToolTip="화면의 GIF를 드래그해 위치와 크기를 바꿉니다 (Ctrl+Alt+E)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7C2;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="편집 모드" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border DockPanel.Dock="Right" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="36">
          <ToggleButton x:Name="HiddenToggle" Style="{StaticResource Switch}" Content="모두 숨기기" FontSize="13"
                        Foreground="{StaticResource LabelBrush}" Click="HiddenToggle_Click" ToolTip="Ctrl+Alt+H"/>
        </Border>
      </DockPanel>
    </Border>

    <!-- ── 라이브러리 탭 ─────────────────────────────── -->
    <Grid x:Name="LibraryView" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="64"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 도구줄 -->
        <DockPanel Margin="20,0" LastChildFill="True" VerticalAlignment="Center">
          <Button DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" Height="36" Padding="14,0" Click="AddFiles_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="PC에서 추가" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
          <Button x:Name="SortButton" DockPanel.Dock="Right" Height="36" Margin="12,0,0,0" Click="SortButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="SortLabel" Text="최근 사용 순" VerticalAlignment="Center"/>
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="최근 사용 순" Tag="recent" Click="SortItem_Click"/>
                <MenuItem Header="추가한 날짜 순" Tag="added" Click="SortItem_Click"/>
                <MenuItem Header="이름 순" Tag="name" Click="SortItem_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" GroupName="filter" Tag="all" IsChecked="True" Checked="Filter_Checked" Content="전체"/>
              <RadioButton x:Name="FilterFavorite" Style="{StaticResource Segment}" GroupName="filter" Tag="favorite" Checked="Filter_Checked" Content="즐겨찾기"/>
              <RadioButton x:Name="FilterRecent" Style="{StaticResource Segment}" GroupName="filter" Tag="recent" Checked="Filter_Checked" Content="최근 사용"/>
            </StackPanel>
          </Border>
          <Grid Margin="12,0,0,0" Height="36">
            <TextBox x:Name="SearchBox" Height="36" Padding="30,0,8,0" TextChanged="SearchBox_TextChanged"/>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                       Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchPlaceholder" Text="라이브러리에서 검색" Foreground="{StaticResource TextMutedBrush}"
                       Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
        </DockPanel>

        <!-- 사진 격자 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,2,6,0">
          <ItemsControl x:Name="PhotoList" ItemTemplate="{StaticResource PhotoCardTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="EmptyLibrary" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="#3A4152" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyText" Text="GIF 파일을 이 창에 끌어다 놓거나 'PC에서 추가'를 누르세요"
                     Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 화면 배치 바 -->
        <Border Grid.Row="2" Background="#0C0E12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="화면에 표시 중" FontWeight="Bold" VerticalAlignment="Center"/>
              <Border CornerRadius="10" Background="#1F2A3F" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ActiveCount" Text="0" FontSize="11.5" Foreground="{StaticResource AccentLightBrush}"/>
              </Border>
              <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Run Text="GIF를 고른 뒤 사진 카드의"/>
                <Run Text="교체" Foreground="{StaticResource WarnTextBrush}" FontWeight="Bold"/>
                <Run Text="를 누르면 위치·크기는 그대로 사진만 바뀌어요"/>
              </TextBlock>
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource ActiveTileTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Width="80" Height="80" BorderBrush="{StaticResource BorderStrongBrush}" Click="AddFiles_Click"
                        ToolTip="PC에서 사진 추가" Foreground="{StaticResource TextMutedBrush}">
                  <StackPanel>
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="추가" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- 안내 토스트 -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                Background="#1E2330" BorderBrush="#34406A" BorderThickness="1" CornerRadius="18" Padding="16,8" Visibility="Collapsed">
          <TextBlock x:Name="ToastText" FontSize="12.5"/>
        </Border>
      </Grid>

      <!-- 속성 패널 -->
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <Grid>
          <TextBlock x:Name="PanelEmpty" Text="라이브러리의 사진이나&#10;화면에 표시 중인 GIF를 선택하세요"
                     TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <DockPanel x:Name="PanelContent" Margin="16" LastChildFill="True">

            <!-- 아래 버튼들 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <Button x:Name="BgRemoveButton" Height="38" Click="BgRemove_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEF3C;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="배경 지우기…" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Grid x:Name="ActiveButtons" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnDanger}" Height="38" Content="화면에서 내리기" Click="RemoveFromScreen_Click"/>
                <Button Grid.Column="2" Style="{StaticResource BtnSoftAccent}" Height="38" Content="화면에서 조정" Click="EditMode_Click"/>
              </Grid>
              <StackPanel x:Name="PhotoButtons" Margin="0,8,0,0">
                <Button x:Name="ReplaceSelectedButton" Style="{StaticResource BtnWarn}" Height="38" Click="ReplaceSelected_Click" Margin="0,0,0,8"/>
                <Button Style="{StaticResource BtnPrimary}" Height="40" Content="화면에 추가" Click="AddToScreen_Click"/>
              </StackPanel>
            </StackPanel>

            <StackPanel>
              <!-- 머리말 -->
              <DockPanel>
                <Border x:Name="ScreenBadge" DockPanel.Dock="Right" CornerRadius="11" Background="#243DD68C" Padding="8,2" VerticalAlignment="Center">
                  <TextBlock x:Name="ScreenBadgeText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenTextBrush}"/>
                </Border>
                <StackPanel>
                  <TextBlock x:Name="PanelSubtitle" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                  <TextBlock x:Name="PanelTitle" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>

              <Border Height="160" Margin="0,12,0,0" CornerRadius="10" Background="{StaticResource CheckerBrush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="10"
                       RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <ScaleTransform x:Name="PreviewFlip" ScaleX="1"/>
                  </Image.RenderTransform>
                </Image>
              </Border>
              <TextBlock x:Name="PanelInfo" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>

              <!-- 화면 GIF 속성 -->
              <StackPanel x:Name="ActiveProps" Margin="0,12,0,0">
                <TextBlock Text="위치" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <TextBox x:Name="XBox" Padding="24,0,6,0" FontFamily="{StaticResource MonoFont}" KeyDown="PosBox_KeyDown" LostKeyboardFocus="PosBox_LostFocus"/>
                    <TextBlock Text="X" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
                  </Grid>
                  <Grid Grid.Column="2">
                    <TextBox x:Name="YBox" Padding="24,0,6,0" FontFamily="{StaticResource MonoFont}" KeyDown="PosBox_KeyDown" LostKeyboardFocus="PosBox_LostFocus"/>
                    <TextBlock Text="Y" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
                  </Grid>
                  <Border Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="3">
                    <UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" Width="44" Height="28"/>
                  </Border>
                </Grid>

                <DockPanel Margin="0,14,0,0">
                  <Button DockPanel.Dock="Right" Height="24" Padding="8,0" FontSize="11" Content="원래 크기" Margin="8,0,0,0" Click="ResetScale_Click"/>
                  <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                  <TextBlock Text="크기" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                </DockPanel>
                <Slider x:Name="ScaleSlider" Minimum="10" Maximum="400" Margin="0,4,0,0" ValueChanged="ScaleSlider_ValueChanged"/>

                <DockPanel Margin="0,10,0,0">
                  <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Text="투명도" Style="{StaticResource SectionLabel}"/>
                </DockPanel>
                <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Margin="0,4,0,0" ValueChanged="OpacitySlider_ValueChanged"/>

                <DockPanel Margin="0,10,0,0">
                  <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}" Padding="2">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="Speed05" Style="{StaticResource Segment}" GroupName="speed" Tag="0.5" Content="0.5×" Height="26" Checked="Speed_Checked"/>
                      <RadioButton x:Name="Speed1" Style="{StaticResource Segment}" GroupName="speed" Tag="1" Content="1×" Height="26" Checked="Speed_Checked"/>
                      <RadioButton x:Name="Speed2" Style="{StaticResource Segment}" GroupName="speed" Tag="2" Content="2×" Height="26" Checked="Speed_Checked"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="재생 속도" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="FlipToggle" Style="{StaticResource SwitchBox}" Content="좌우 반전" Click="FlipToggle_Click"/>
                  <ToggleButton x:Name="ClickThroughToggle" Grid.Column="2" Style="{StaticResource SwitchBox}" Content="클릭 통과"
                                Click="ClickThroughToggle_Click" ToolTip="켜면 GIF 위를 클릭해도 아래 프로그램(게임)이 클릭됩니다"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ── 설정 탭 ───────────────────────────────────── -->
    <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel Width="720" Margin="0,28,0,28">

        <TextBlock Text="일반" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="#22262F" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <ToggleButton x:Name="StartWithWindowsToggle" Style="{StaticResource Switch}" Margin="18,14" Click="StartWithWindows_Click">
              <StackPanel>
                <TextBlock Text="Windows 시작 시 자동 실행" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="컴퓨터를 켜면 GifPin이 트레이에서 시작되고 저장된 GIF를 바로 띄워요" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </ToggleButton>
            <Border Height="1" Background="{StaticResource LineBrush}"/>
            <ToggleButton x:Name="OpenOnStartToggle" Style="{StaticResource Switch}" Margin="18,14" Click="OpenOnStart_Click">
              <StackPanel>
                <TextBlock Text="자동 실행할 때 메인 창 열기" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="끄면 메인 창 없이 트레이 아이콘으로만 시작해요" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <TextBlock Text="단축키" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,22,0,8"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="#22262F" BorderThickness="1" CornerRadius="12">
          <StackPanel x:Name="HotkeyRows"/>
        </Border>

        <TextBlock Text="라이브러리" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,22,0,8"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="#22262F" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <DockPanel Margin="18,14">
              <Button DockPanel.Dock="Right" Height="30" Content="폴더 열기" Click="OpenDataFolder_Click" Margin="12,0,0,0"/>
              <StackPanel>
                <TextBlock Text="데이터 폴더" FontSize="14"/>
                <TextBlock x:Name="DataFolderText" FontFamily="{StaticResource MonoFont}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Height="1" Background="{StaticResource LineBrush}"/>
            <ToggleButton x:Name="CopyOnAddToggle" Style="{StaticResource Switch}" Margin="18,14" Click="CopyOnAdd_Click">
              <StackPanel>
                <TextBlock Text="추가할 때 라이브러리로 복사" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="원본 파일을 옮기거나 지워도 계속 쓸 수 있어요" Style="{StaticResource Hint}" FontSize="12" Margin="0,2,0,0"/>
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" FontSize="12" Margin="0,18,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
