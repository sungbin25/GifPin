<Window x:Class="GifPin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GifPin" Width="1280" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="/Assets/GifPin.ico" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 라이브러리 카드 -->
    <DataTemplate x:Key="PhotoCardTemplate">
      <Border x:Name="Card" Width="164" Margin="0,0,14,14" CornerRadius="10" Background="{StaticResource CardBrush}"
              BorderThickness="2" BorderBrush="Transparent" Cursor="Hand"
              MouseLeftButtonDown="Card_MouseDown" MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{DynamicResource s.card.addToScreen}" Click="CardMenu_Add"/>
            <MenuItem Header="{DynamicResource s.card.replaceSelected}" Click="CardMenu_Replace" IsEnabled="{Binding CanReplace}"/>
            <MenuItem Header="{DynamicResource s.card.removeBg}" Click="CardMenu_BgRemove" FontWeight="Bold"/>
            <Separator/>
            <MenuItem Header="{DynamicResource s.card.favorite}" Click="CardMenu_Favorite"/>
            <MenuItem Header="{DynamicResource s.card.exportPack}" Click="CardMenu_ExportPack"/>
            <MenuItem Header="{DynamicResource s.card.openFolder}" Click="CardMenu_OpenFolder"/>
            <Separator/>
            <MenuItem Header="{DynamicResource s.card.remove}" Click="CardMenu_Remove" Foreground="{StaticResource DangerBrush}"/>
          </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
          <Grid Height="148">
            <Border CornerRadius="8,8,0,0" Background="{StaticResource CheckerBrush}">
              <Image Source="{Binding Display}" Stretch="Uniform" StretchDirection="DownOnly" Margin="8"
                     RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <Border x:Name="InUseBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8" Padding="8,3" CornerRadius="10" Background="{StaticResource BadgeBgBrush}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource s.card.inUse}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenTextBrush}"/>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource BtnIcon}" Width="28" Height="28" Background="#990A0E12"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4" Click="Card_Star" ToolTip="{DynamicResource s.card.favorite}">
              <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
            <Grid x:Name="HoverBar" VerticalAlignment="Bottom" Margin="8" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource BtnPrimary}" Height="28" Padding="0" FontSize="11.5" Content="{DynamicResource s.card.add}" Click="Card_Add"/>
              <Button Grid.Column="2" Style="{StaticResource BtnWarn}" Height="28" Padding="0" FontSize="11.5" Content="{DynamicResource s.card.replace}"
                      Click="Card_Replace" IsEnabled="{Binding CanReplace}" ToolTip="{DynamicResource s.card.replaceTip}"/>
            </Grid>
          </Grid>
          <StackPanel Margin="10,8,10,10">
            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding InUse}" Value="True">
          <Setter TargetName="InUseBadge" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Favorite}" Value="True">
          <Setter TargetName="Star" Property="Text" Value="&#xE735;"/>
          <Setter TargetName="Star" Property="Foreground" Value="#FFD166"/>
        </DataTrigger>
        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
          <Setter TargetName="HoverBar" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Card" Property="BorderBrush" Value="#3A4152"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 화면 배치 바 타일 -->
    <DataTemplate x:Key="ActiveTileTemplate">
      <Border x:Name="Tile" Margin="0,0,12,0" Padding="6,6,10,6" CornerRadius="10" BorderThickness="2"
              BorderBrush="#22262F" Background="{StaticResource PanelBrush}" Cursor="Hand" MouseLeftButtonDown="Tile_MouseDown">
        <StackPanel Orientation="Horizontal">
          <Border Width="64" Height="64" CornerRadius="8" Background="{StaticResource CheckerBrush}" Opacity="{Binding TileOpacity}">
            <Image Source="{Binding Thumb}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" Width="130">
            <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,6" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal">
              <Button Width="26" Height="26" Padding="0" Click="Tile_Eye" ToolTip="{Binding EyeTip}">
                <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
              </Button>
              <Button Width="26" Height="26" Padding="0" Margin="4,0,0,0" Click="Tile_Remove" ToolTip="{DynamicResource s.panel.removeFromScreen}">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
          <Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedBgBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="SettingsCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="#22262F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style x:Key="SettingsHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
      <Setter Property="Margin" Value="0,22,0,8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 탭 바 -->
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="{StaticResource ChromeBrush}">
      <DockPanel Margin="12,0,16,0" LastChildFill="False">
        <Image Source="/Assets/GifPin.ico" Width="20" Height="20" Margin="4,0,8,0" DockPanel.Dock="Left"/>
        <RadioButton x:Name="TabLibrary" Style="{StaticResource TabRadio}" GroupName="tabs" Content="{DynamicResource s.tab.library}"
                     IsChecked="True" DockPanel.Dock="Left" Checked="Tab_Checked"/>
        <RadioButton x:Name="TabSettings" Style="{StaticResource TabRadio}" GroupName="tabs" Content="{DynamicResource s.tab.settings}"
                     DockPanel.Dock="Left" Checked="Tab_Checked"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Height="36" Padding="16,0"
                Margin="8,0,0,0" Click="EditMode_Click" ToolTip="{DynamicResource s.top.editTip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7C2;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{DynamicResource s.top.edit}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border DockPanel.Dock="Right" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,0" Height="36">
          <ToggleButton x:Name="HiddenToggle" Style="{StaticResource Switch}" Content="{DynamicResource s.top.hideAll}" FontSize="13"
                        Foreground="{StaticResource LabelBrush}" Click="HiddenToggle_Click"/>
        </Border>
      </DockPanel>
    </Border>

    <!-- ── 라이브러리 탭 ─────────────────────────────── -->
    <Grid x:Name="LibraryView" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 도구줄 -->
        <StackPanel Margin="20,14,20,10">
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Left" Style="{StaticResource BtnSecondary}" Height="36" Padding="14,0" Click="AddFiles_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource s.lib.add}" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Height="36" Padding="12,0" Margin="8,0,0,0" Click="Sprite_Click" ToolTip="{DynamicResource s.lib.spriteTip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource s.lib.sprite}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="PackButton" DockPanel.Dock="Left" Height="36" Padding="12,0" Margin="8,0,0,0" Click="PackButton_Click" ToolTip="{DynamicResource s.lib.packTip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource s.lib.pack}" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{DynamicResource s.pack.import}" Click="PackImport_Click"/>
                  <Separator/>
                  <MenuItem Header="{DynamicResource s.pack.exportScreen}" Click="PackExportScreen_Click"/>
                  <MenuItem Header="{DynamicResource s.pack.exportFavorites}" Click="PackExportFavorites_Click"/>
                  <MenuItem Header="{DynamicResource s.pack.exportAll}" Click="PackExportAll_Click"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Grid Margin="12,0,0,0" Height="36">
              <TextBox x:Name="SearchBox" Height="36" Padding="30,0,8,0" TextChanged="SearchBox_TextChanged"/>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                         Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource s.lib.search}" Foreground="{StaticResource TextMutedBrush}"
                         Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </DockPanel>
          <DockPanel Margin="0,10,0,0" LastChildFill="False">
            <Border DockPanel.Dock="Left" Style="{StaticResource SegmentBox}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" GroupName="filter" Tag="all" IsChecked="True" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterFavorite" Style="{StaticResource Segment}" GroupName="filter" Tag="favorite" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterRecent" Style="{StaticResource Segment}" GroupName="filter" Tag="recent" Checked="Filter_Checked" Content="{DynamicResource s.lib.filterRecent}"/>
              </StackPanel>
            </Border>
            <Button x:Name="SortButton" DockPanel.Dock="Right" Height="34" Click="SortButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SortLabel" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{DynamicResource s.sort.recent}" Tag="recent" Click="SortItem_Click"/>
                  <MenuItem Header="{DynamicResource s.sort.added}" Tag="added" Click="SortItem_Click"/>
                  <MenuItem Header="{DynamicResource s.sort.name}" Tag="name" Click="SortItem_Click"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </DockPanel>
        </StackPanel>

        <!-- 사진 격자 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,2,6,0">
          <ItemsControl x:Name="PhotoList" ItemTemplate="{StaticResource PhotoCardTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel x:Name="EmptyLibrary" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="#3A4152" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>

        <!-- 화면 배치 바 -->
        <Border Grid.Row="2" Background="#0C0E12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12,20,14">
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Text="{DynamicResource s.bar.title}" FontWeight="Bold" VerticalAlignment="Center"/>
              <Border CornerRadius="10" Background="#1F2A3F" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ActiveCount" Text="0" FontSize="11.5" Foreground="{StaticResource AccentLightBrush}"/>
              </Border>
              <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="{DynamicResource s.bar.hint}" TextTrimming="CharacterEllipsis" Margin="16,0,0,0"/>
            </DockPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="ActiveList" ItemTemplate="{StaticResource ActiveTileTemplate}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button Width="80" Height="80" BorderBrush="{StaticResource BorderStrongBrush}" Click="AddFiles_Click"
                        ToolTip="{DynamicResource s.lib.add}" Foreground="{StaticResource TextMutedBrush}">
                  <StackPanel>
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource s.bar.add}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <!-- 안내 토스트 -->
        <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,16"
                Background="#1E2330" BorderBrush="#34406A" BorderThickness="1" CornerRadius="18" Padding="16,8" Visibility="Collapsed">
          <TextBlock x:Name="ToastText" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>
      </Grid>

      <!-- 속성 패널 -->
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
        <Grid>
          <TextBlock x:Name="PanelEmpty" Text="{DynamicResource s.panel.empty}" TextWrapping="Wrap" Margin="24,0"
                     TextAlignment="Center" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <DockPanel x:Name="PanelContent" LastChildFill="True">

            <!-- 아래 버튼들 -->
            <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,16">
              <Button Height="38" Click="BgRemove_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xEF3C;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource s.panel.removeBg}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="StyleButton" Height="34" Margin="0,8,0,0" Content="{DynamicResource s.panel.copyPaste}" Click="StyleButton_Click"/>
              <Grid x:Name="ActiveButtons" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnDanger}" Height="38" Content="{DynamicResource s.panel.removeFromScreen}" Click="RemoveFromScreen_Click"/>
                <Button Grid.Column="2" Style="{StaticResource BtnSoftAccent}" Height="38" Content="{DynamicResource s.panel.adjustOnScreen}" Click="EditMode_Click"/>
              </Grid>
              <StackPanel x:Name="PhotoButtons" Margin="0,8,0,0">
                <Button x:Name="ReplaceSelectedButton" Style="{StaticResource BtnWarn}" Height="38" Click="ReplaceSelected_Click" Margin="0,0,0,8"/>
                <Button Style="{StaticResource BtnPrimary}" Height="40" Content="{DynamicResource s.panel.addToScreen}" Click="AddToScreen_Click"/>
              </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="16,16,12,0">
                <!-- 머리말 -->
                <DockPanel>
                  <Border x:Name="ScreenBadge" DockPanel.Dock="Right" CornerRadius="11" Background="#243DD68C" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock x:Name="ScreenBadgeText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GreenTextBrush}"/>
                  </Border>
                  <StackPanel>
                    <TextBlock x:Name="PanelSubtitle" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock x:Name="PanelTitle" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>

                <Border Height="140" Margin="0,12,0,0" CornerRadius="10" Background="{StaticResource CheckerBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                  <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="10"
                         RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <ScaleTransform x:Name="PreviewFlip" ScaleX="1"/>
                    </Image.RenderTransform>
                  </Image>
                </Border>
                <TextBlock x:Name="PanelInfo" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                <ToggleButton x:Name="PixelToggle" Style="{StaticResource SwitchBox}" Margin="0,10,0,0" Click="PixelToggle_Click"
                              Content="{DynamicResource s.panel.pixelArt}" ToolTip="{DynamicResource s.panel.pixelArtTip}"/>

                <!-- 화면 GIF 속성 -->
                <StackPanel x:Name="ActiveProps" Margin="0,4,0,8">

                  <DockPanel x:Name="MonitorRow" Margin="0,12,0,0">
                    <Button x:Name="MonitorButton" DockPanel.Dock="Right" Height="30" Padding="10,0" Click="MonitorButton_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MonitorLabel" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                      <Button.ContextMenu>
                        <ContextMenu/>
                      </Button.ContextMenu>
                    </Button>
                    <TextBlock Text="{DynamicResource s.panel.monitor}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                  </DockPanel>

                  <TextBlock Text="{DynamicResource s.panel.position}" Style="{StaticResource SectionLabel}" Margin="0,14,0,0"/>
                  <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                      <TextBox x:Name="XBox" Padding="24,0,6,0" FontFamily="{StaticResource MonoFont}" KeyDown="PosBox_KeyDown" LostKeyboardFocus="PosBox_LostFocus"/>
                      <TextBlock Text="X" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid Grid.Column="2">
                      <TextBox x:Name="YBox" Padding="24,0,6,0" FontFamily="{StaticResource MonoFont}" KeyDown="PosBox_KeyDown" LostKeyboardFocus="PosBox_LostFocus"/>
                      <TextBlock Text="Y" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"/>
                    </Grid>
                    <Border Grid.Column="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="3">
                      <UniformGrid x:Name="AnchorGrid" Rows="3" Columns="3" Width="44" Height="28"/>
                    </Border>
                  </Grid>

                  <DockPanel Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Height="24" Padding="8,0" FontSize="11" Content="{DynamicResource s.panel.originalSize}" Margin="8,0,0,0" Click="ResetScale_Click"/>
                    <TextBlock x:Name="ScaleText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource s.panel.size}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Slider x:Name="ScaleSlider" Minimum="10" Maximum="400" Margin="0,4,0,0" ValueChanged="ScaleSlider_ValueChanged"/>

                  <DockPanel Margin="0,10,0,0">
                    <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}"/>
                    <TextBlock Text="{DynamicResource s.panel.opacity}" Style="{StaticResource SectionLabel}"/>
                  </DockPanel>
                  <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Margin="0,4,0,0" ValueChanged="OpacitySlider_ValueChanged"/>

                  <DockPanel Margin="0,10,0,0">
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}" Padding="2">
                      <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Speed05" Style="{StaticResource Segment}" GroupName="speed" Tag="0.5" Content="0.5×" Height="26" Checked="Speed_Checked"/>
                        <RadioButton x:Name="Speed1" Style="{StaticResource Segment}" GroupName="speed" Tag="1" Content="1×" Height="26" Checked="Speed_Checked"/>
                        <RadioButton x:Name="Speed2" Style="{StaticResource Segment}" GroupName="speed" Tag="2" Content="2×" Height="26" Checked="Speed_Checked"/>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{DynamicResource s.panel.playSpeed}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                  </DockPanel>

                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="FlipToggle" Style="{StaticResource SwitchBox}" Content="{DynamicResource s.panel.flip}" Click="FlipToggle_Click"/>
                    <ToggleButton x:Name="ClickThroughToggle" Grid.Column="2" Style="{StaticResource SwitchBox}" Content="{DynamicResource s.panel.clickThrough}"
                                  Click="ClickThroughToggle_Click" ToolTip="{DynamicResource s.panel.clickThroughTip}"/>
                  </Grid>

                  <!-- 표시 층 -->
                  <TextBlock Text="{DynamicResource s.panel.layer}" Style="{StaticResource SectionLabel}" Margin="0,16,0,0"/>
                  <Border Style="{StaticResource SegmentBox}" Margin="0,6,0,0" Padding="2" ToolTip="{DynamicResource s.panel.layerTip}">
                    <UniformGrid Columns="2">
                      <RadioButton x:Name="LayerTop" Style="{StaticResource Segment}" GroupName="layer" Tag="top" Padding="4,0" Content="{DynamicResource s.layer.top}" Checked="Layer_Checked"/>
                      <RadioButton x:Name="LayerDesktop" Style="{StaticResource Segment}" GroupName="layer" Tag="desktop" Padding="4,0" Content="{DynamicResource s.layer.desktop}" Checked="Layer_Checked"/>
                    </UniformGrid>
                  </Border>
                  <TextBlock x:Name="LayerHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>

                  <!-- 움직임 -->
                  <TextBlock Text="{DynamicResource s.panel.motion}" Style="{StaticResource SectionLabel}" Margin="0,16,0,0"/>
                  <Border Style="{StaticResource SegmentBox}" Margin="0,6,0,0" Padding="2">
                    <UniformGrid Columns="5">
                      <RadioButton x:Name="MotionNone" Style="{StaticResource Segment}" GroupName="motion" Tag="none" Padding="4,0" Content="{DynamicResource s.motion.none}" Checked="Motion_Checked"/>
                      <RadioButton x:Name="MotionWalk" Style="{StaticResource Segment}" GroupName="motion" Tag="walk" Padding="4,0" Content="{DynamicResource s.motion.walk}" Checked="Motion_Checked"/>
