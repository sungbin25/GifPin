<Window x:Class="GifPin.UI.BgRemoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="배경 지우기" Width="960" Height="640" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="/Assets/GifPin.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>

    <!-- 미리보기 -->
    <Grid Margin="20,18,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Height="28">
            <TextBlock x:Name="PickHint" DockPanel.Dock="Right" Text="클릭해서 배경색 고르기" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
            <TextBlock Text="원본" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
          </DockPanel>
          <Border CornerRadius="10" Background="{StaticResource CheckerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Image x:Name="OrigImage" Stretch="None" Cursor="Cross" HorizontalAlignment="Center" VerticalAlignment="Center"
                     MouseLeftButtonDown="Preview_MouseDown">
                <Image.LayoutTransform>
                  <ScaleTransform x:Name="OrigZoom" ScaleX="1" ScaleY="1"/>
                </Image.LayoutTransform>
              </Image>
            </ScrollViewer>
          </Border>
        </DockPanel>

        <DockPanel Grid.Column="2">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" Height="28">
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}" Padding="2">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="resultBg" Tag="checker" Content="체크무늬" Height="22" IsChecked="True" Checked="ResultBg_Checked"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="resultBg" Tag="dark" Content="어둡게" Height="22" Checked="ResultBg_Checked"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="resultBg" Tag="light" Content="밝게" Height="22" Checked="ResultBg_Checked"/>
              </StackPanel>
            </Border>
            <TextBlock Text="결과" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
          </DockPanel>
          <Border x:Name="ResultBg" CornerRadius="10" Background="{StaticResource CheckerBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <Image x:Name="ResultImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                     MouseLeftButtonDown="Preview_MouseDown">
                <Image.LayoutTransform>
                  <ScaleTransform x:Name="ResultZoom" ScaleX="1" ScaleY="1"/>
                </Image.LayoutTransform>
              </Image>
            </ScrollViewer>
          </Border>
        </DockPanel>

        <TextBlock x:Name="LoadingText" Grid.ColumnSpan="3" Text="불러오는 중…" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMutedBrush}"/>
      </Grid>

      <!-- 프레임 컨트롤 -->
      <DockPanel Grid.Row="1" Margin="0,12,0,0" Height="40">
        <Button x:Name="PlayButton" DockPanel.Dock="Left" Width="36" Height="36" Padding="0" Background="#181C24" Click="Play_Click" ToolTip="재생 / 일시정지">
          <TextBlock x:Name="PlayIcon" Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
        </Button>
        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentBox}" Padding="2" Margin="12,0,0,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" GroupName="zoom" Tag="1" Content="100%" IsChecked="True" Checked="Zoom_Checked"/>
            <RadioButton Style="{StaticResource Segment}" GroupName="zoom" Tag="2" Content="200%" Checked="Zoom_Checked"/>
          </StackPanel>
        </Border>
        <TextBlock x:Name="FrameText" DockPanel.Dock="Right" Width="70" TextAlignment="Right" VerticalAlignment="Center"
                   FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource LabelBrush}"/>
        <Slider x:Name="FrameSlider" Margin="12,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="0"
                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="FrameSlider_ValueChanged"/>
      </DockPanel>
    </Grid>

    <!-- 설정 패널 -->
    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
      <DockPanel Margin="18,18,18,16">

        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="저장할 이름" Style="{StaticResource SectionLabel}"/>
          <TextBox x:Name="NameBox" Margin="0,6,0,0"/>
          <TextBlock Text="원본은 그대로 두고 새 사진(WebP)으로 라이브러리에 추가해요" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          <StackPanel x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="SaveProgress" Minimum="0" Maximum="1"/>
            <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          </StackPanel>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Height="40" Content="취소" BorderBrush="{StaticResource BorderStrongBrush}" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Grid.Column="2" Height="40" Style="{StaticResource BtnPrimary}" Content="저장" Click="Save_Click" IsEnabled="False"/>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="SettingsPanel">
          <DockPanel>
            <Border x:Name="AutoBadge" DockPanel.Dock="Right" CornerRadius="10" Background="#244C8DFF" Padding="8,2" Visibility="Collapsed">
              <TextBlock Text="자동 감지됨" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/>
            </Border>
            <TextBlock Text="배경색" Style="{StaticResource SectionLabel}"/>
          </DockPanel>
          <DockPanel Margin="0,8,0,0">
            <Border x:Name="Swatch" DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" BorderBrush="#3A4152" BorderThickness="1" Background="White"/>
            <Button x:Name="PickButton" DockPanel.Dock="Right" Style="{StaticResource BtnSoftAccent}" Height="36" Padding="10,0" Margin="8,0,0,0" Click="PickButton_Click"
                    ToolTip="누른 뒤 원본이나 결과 미리보기에서 배경 부분을 클릭">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEF3C;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="스포이드" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBox x:Name="HexBox" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}" KeyDown="HexBox_KeyDown" LostKeyboardFocus="HexBox_LostFocus"/>
          </DockPanel>
          <TextBlock x:Name="TransparentNotice" Text="이 사진은 이미 배경이 투명합니다. 다른 색을 지우려면 스포이드로 고르세요."
                     Style="{StaticResource Hint}" Foreground="{StaticResource WarnTextBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>

          <DockPanel Margin="0,20,0,0">
            <TextBlock x:Name="TolText" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}"/>
            <TextBlock Text="허용 오차" Style="{StaticResource SectionLabel}"/>
          </DockPanel>
          <Slider x:Name="TolSlider" Minimum="0" Maximum="100" Value="15" Margin="0,4,0,0"
                  IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="TolSlider_ValueChanged"/>
          <TextBlock Text="높일수록 배경과 비슷한 색까지 함께 지워요" Style="{StaticResource Hint}" Margin="0,2,0,0"/>

          <Border Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{StaticResource InputBrush}" Padding="12">
            <ToggleButton x:Name="ConnectedToggle" Style="{StaticResource Switch}" IsChecked="True" Click="Setting_Changed">
              <StackPanel>
                <TextBlock Text="가장자리에서 이어진 부분만" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="윤곽선 안쪽의 흰 얼굴·몸은 지우지 않아요" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
              </StackPanel>
            </ToggleButton>
          </Border>

          <TextBlock Text="가장자리 다듬기" Style="{StaticResource SectionLabel}" Margin="0,20,0,0"/>
          <Border Style="{StaticResource SegmentBox}" Margin="0,8,0,0">
            <UniformGrid Columns="4">
              <RadioButton Style="{StaticResource Segment}" GroupName="refine" Tag="0" Content="0px" Checked="Setting_Changed"/>
              <RadioButton x:Name="Refine1" Style="{StaticResource Segment}" GroupName="refine" Tag="1" Content="1px" IsChecked="True" Checked="Setting_Changed"/>
              <RadioButton Style="{StaticResource Segment}" GroupName="refine" Tag="2" Content="2px" Checked="Setting_Changed"/>
              <RadioButton Style="{StaticResource Segment}" GroupName="refine" Tag="3" Content="3px" Checked="Setting_Changed"/>
            </UniformGrid>
          </Border>
          <TextBlock Text="윤곽선 주변의 하얀 테두리를 정리해요" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
